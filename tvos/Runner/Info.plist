<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <!--
    The playback engine fetches media through URLSession, which enforces App
    Transport Security. iOS and macOS already declare this exception. Without
    it here, any http server address that uses a hostname instead of an IP is
    blocked on device before the request is ever sent, so playback dies while
    every Dart side API call still works.

    Do not add NSAllowsLocalNetworking alongside this. The system ignores
    NSAllowsArbitraryLoads whenever that key is present, which leaves single
    label hosts working and every fully qualified one refused.
  -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <true/>
  </dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>$(DEVELOPMENT_LANGUAGE)</string>
  <key>CFBundleDisplayName</key>
  <string>Moonfin</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>moonfin</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>CFBundleURLName</key>
      <string>org.moonfin.app</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>moonfin</string>
      </array>
    </dict>
  </array>
  <key>CFBundleShortVersionString</key>
  <string>$(FLUTTER_BUILD_NAME)</string>
  <key>CFBundleVersion</key>
  <string>$(FLUTTER_BUILD_NUMBER)</string>
  <!--
    flutter-tvos copies `flutter_assets` to the app bundle root, but the
    prebuilt tvOS device engine's `+[FlutterDartProject lookupKeyForAsset:]`
    otherwise defaults to the iOS `Frameworks/App.framework/flutter_assets`
    path. Without this override every plugin that resolves a bundled asset
    via `lookupKeyForAsset:` (e.g. `VideoPlayerController.asset`) gets a
    path that does not exist on a physical device. `FLTAssetsPath` points
    the engine at the directory the build actually produces.
  -->
  <key>FLTAssetsPath</key>
  <string>flutter_assets</string>
  <key>UIMainStoryboardFile</key>
  <string>Main</string>
  <key>UIRequiredDeviceCapabilities</key>
  <array>
    <string>arm64</string>
  </array>
  <key>GCSupportsControllerUserInteraction</key>
  <true/>
  <key>GCSupportedGameControllers</key>
  <array>
    <dict>
      <key>ProfileName</key>
      <string>ExtendedGamepad</string>
    </dict>
    <dict>
      <key>ProfileName</key>
      <string>MicroGamepad</string>
    </dict>
  </array>
</dict>
</plist>
